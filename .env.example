# En Netlify: Site configuration > Environment variables
# Copia este archivo a .env y rellena los valores reales. Nunca subas .env al repositorio.

AUTH_USER=tu-usuario
AUTH_PASS=tu-contraseña
UPSTASH_REDIS_REST_URL=https://tu-instancia.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu-token-de-upstash
MOODLE_TOKEN=tu-token-de-moodle
COMPOSIO_API_KEY=tu-api-key-de-composio
COMPOSIO_USER_ID=default
BLOB_READ_WRITE_TOKEN=tu-token-de-blob
