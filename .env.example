# En Netlify: Site configuration > Environment variables
# Type = "Secret" en todas (marca las que quieras ocultar en la UI).

AUTH_USER=tareas
AUTH_PASS=tu_contraseña
UPSTASH_REDIS_REST_URL=tu_url_upstash
UPSTASH_REDIS_REST_TOKEN=tu_token_upstash
MOODLE_TOKEN=tu_token_moodle
COMPOSIO_API_KEY=tu_api_key_composio
COMPOSIO_USER_ID=default
BLOB_READ_WRITE_TOKEN=tu_token_blob  # solo para la migración inicial; bórralo después
