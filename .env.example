# En Netlify: Project configuration > Environment variables
# Type = "Secret" en todas (marca las que quieras ocultar en la UI).
#
# IMPORTANTE: aquí solo van los NOMBRES. Los valores reales se definen en Netlify.
# No escribas valores reales en este fichero: el escáner de secretos de Netlify
# compara el contenido del repo con el valor de cada variable y, si coincide,
# bloquea el build ("Exposed secrets detected").

AUTH_USER=
AUTH_PASS=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MOODLE_TOKEN=
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
BLOB_READ_WRITE_TOKEN=
